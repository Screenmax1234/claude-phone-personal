# ====================================
# Claude Phone Configuration
# ====================================
# Copy this to .env and fill in your values

# ====================================
# Network Configuration
# ====================================

# Your server's LAN IP (CRITICAL for RTP audio)
# This IP goes into SDP packets so 3CX knows where to send audio
EXTERNAL_IP=10.0.0.100

# ====================================
# Drachtio Configuration
# ====================================

DRACHTIO_HOST=127.0.0.1
DRACHTIO_PORT=9022
DRACHTIO_SECRET=cymru

# SIP port for Contact header (5070 for 3CX SBC mode, 5060 for direct registration)
# This MUST match the port in docker-compose.yml drachtio command
DRACHTIO_SIP_PORT=5060

# ====================================
# FreeSWITCH Configuration
# ====================================

FREESWITCH_HOST=127.0.0.1
FREESWITCH_PORT=8021
FREESWITCH_SECRET=JambonzR0ck$

# ====================================
# 3CX / SIP Configuration
# ====================================

# Your 3CX server hostname or IP
SIP_DOMAIN=your-3cx-server.3cx.us
SIP_REGISTRAR=10.0.0.50

# Default extension for outbound calls
SIP_EXTENSION=9000
SIP_AUTH_ID=your-auth-id
SIP_PASSWORD=your-password

# Default caller ID for outbound PSTN calls
DEFAULT_CALLER_ID=+15551234567

# ====================================
# Claude API Server
# ====================================

# URL to your Claude API server (runs on your API server with Claude Max)
CLAUDE_API_URL=http://10.0.0.200:3333

# ====================================
# Text-to-Speech (choose one provider)
# ====================================
# Set TTS_PROVIDER to either "elevenlabs" (native) or "airforce" (gateway).

TTS_PROVIDER=elevenlabs
# Default voice used when a device has no explicit voiceId
TTS_DEFAULT_VOICE=your-default-voice-id

# --- ElevenLabs (native) - used when TTS_PROVIDER=elevenlabs ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Optional: override the default model (eleven_turbo_v2)
# ELEVENLABS_MODEL=eleven_turbo_v2

# --- Airforce (OpenAI-compatible gateway) - used when TTS_PROVIDER=airforce ---
# Hosts the eleven-* and gpt-4o-mini-tts models behind POST /v1/audio/speech.
# Get a key at https://api.airforce/dashboard/#api-keys
AIRFORCE_API_KEY=your-airforce-api-key
# Default model. eleven-* models accept ElevenLabs voice IDs; gpt-4o-mini-tts /
# tts-1 accept OpenAI voice names (alloy, coral, sage, echo, ...).
AIRFORCE_TTS_MODEL=eleven-turbo-v2-5
AIRFORCE_BASE_URL=https://api.airforce/v1

# --- ElectronHub (OpenAI-compatible gateway) - used when TTS_PROVIDER=electronhub ---
# Hosts gpt-4o-mini-tts, tts-1, tts-1-hd, elevenlabs models behind POST /v1/audio/speech.
# Get a key at https://www.electronhub.ai
ELECTRONHUB_API_KEY=your-electronhub-api-key
# Default model. OpenAI models accept voice names (alloy, coral, sage, ...).
ELECTRONHUB_TTS_MODEL=gpt-4o-mini-tts
ELECTRONHUB_BASE_URL=https://api.electronhub.ai/v1

# ====================================
# Groq (Whisper STT)
# ====================================
# Free tier available at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Optional: Override the default transcription model and endpoint
# Default model: whisper-large-v3 (best multilingual accuracy)
# Alt: whisper-large-v3-turbo (faster, but weaker on non-English)
# GROQ_MODEL=whisper-large-v3
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: Force STT language (omit for auto-detect)
# WHISPER_LANGUAGE=el

# ====================================
# Application Settings
# ====================================

# HTTP server port for API and audio file serving
HTTP_PORT=3000

# WebSocket port for audio streaming from FreeSWITCH
WS_PORT=3001

# Audio files directory
AUDIO_DIR=/app/audio

# ====================================
# Outbound Call Settings
# ====================================

# Maximum conversation turns for outbound calls
MAX_CONVERSATION_TURNS=10

# Ring timeout in seconds
OUTBOUND_RING_TIMEOUT=30

# ====================================
# Optional: Debug
# ====================================

# DEBUG=voice-app:*

# ====================================
# Discord Bot (optional)
# ====================================
# Get a token from https://discord.com/developers/applications
# Enable MESSAGE CONTENT INTENT in Bot settings
# DISCORD_BOT_TOKEN=your-bot-token

# Restrict to specific channels/users (comma-separated IDs, blank = all)
# DISCORD_ALLOWED_CHANNELS=
# DISCORD_ALLOWED_USERS=

# Custom system prompt for the Discord bot personality
# DISCORD_SYSTEM_PROMPT=

# ====================================
# Remote API Access (optional)
# ====================================
# Set API_KEY to require auth on claude-api-server (port 3333)
# Requests from localhost bypass auth; remote requests need the key
# API_KEY=your-secret-api-key

# ====================================
# Fast LLM (optional — quick responses)
# ====================================
# For simple questions, bypasses Claude Code for instant responses.
# Default: Groq gpt-oss-120b (~500 tok/s) — free at console.groq.com
#
# FAST_LLM_PROVIDER=groq
# FAST_LLM_BASE_URL=https://api.groq.com/openai/v1
# FAST_LLM_API_KEY=your-groq-key
# FAST_LLM_MODEL=openai/gpt-oss-120b
#
# Optional fallback (used if Groq errors/rate-limits)
# FAST_LLM_FALLBACK_PROVIDER=electronhub
# FAST_LLM_FALLBACK_BASE_URL=https://api.electronhub.ai/v1
# FAST_LLM_FALLBACK_API_KEY=your-eh-key
# FAST_LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
#
# FAST_LLM_TIMEOUT=5
